BOT_TOKEN=PUT_YOUR_TOKEN_HERE
BOT_USERNAME=Whatsmuziccbot
ADMIN_IDS=691651240
DAILY_LIMIT=20
RATE_LIMIT=10

# engines that vote (acr, shazam)
ENGINES=acr,shazam
MAX_SAMPLES=10
STRICT=1

# ACRCloud
ACR_TIMEOUT=10        # changed (was 12)
ACR_THREADS=16
