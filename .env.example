RATE_LIMIT=10

# engines
ENGINES=acr,shazam
MAX_SAMPLES=10
STRICT=1

# ACRCloud
ACR_TIMEOUT=10
ACR_THREADS=16
ACR_BUDGET=10
WAVE_TIMEOUT=12
HUM_MIN_SCORE=40
