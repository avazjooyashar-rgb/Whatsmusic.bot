HUM_MIN_SCORE=45      # changed (was 60)

# Shazam
SHAZAM_TIMEOUT=7      # changed (was 20)
SHAZAM_MAX_FAILS=3
SHAZAM_PAUSE=300
SHAZAM_THREADS=3

# lyrics + second chance
LYRICS_ENGINE=1
WHISPER_MODEL=base
WHISPER_WAIT=25
SECOND_CHANCE=1
SILENT_DB=-48

# own fingerprint DB
FP_MIN_ALIGNED=18

# downloads
