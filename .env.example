BOT_TOKEN=PUT_YOUR_TOKEN_HERE
BOT_USERNAME=Whatsmuziccbot
ADMIN_IDS=691651240
DAILY_LIMIT=20
RATE_LIMIT=10

# engines that vote (acr, shazam)
ENGINES=acr,shazam
MAX_SAMPLES=10
STRICT=1

# ACRCloud
ACR_TIMEOUT=12
ACR_THREADS=16
WAVE_TIMEOUT=22
HUM_MIN_SCORE=60

# Shazam: skipped for a while after a few failures in a row
SHAZAM_TIMEOUT=20
SHAZAM_MAX_FAILS=3
SHAZAM_PAUSE=300
SHAZAM_THREADS=3

# nothing confirmed -> lyrics (needs faster-whisper), then cleaned / tempo-shifted audio
LYRICS_ENGINE=1
WHISPER_MODEL=base
WHISPER_WAIT=25
SECOND_CHANCE=1
SILENT_DB=-48

# own fingerprint DB (higher = fewer wrong answers, more misses)
FP_MIN_ALIGNED=18

# downloads
DL_CONCURRENCY=4
ARIA2=1
COOKIES_FILE=cookies.txt

# optional
ODESLI_KEY=

# first ACRCloud account: only read when the accounts table is empty
ACR_HOST=
ACR_KEY=
ACR_SECRET=
